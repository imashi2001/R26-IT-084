# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.env
*.egg-info/
dist/
build/
.venv/
venv/

# YOLO base model (downloaded automatically, not needed in repo)
yolov8n.pt
yolov8s.pt
yolov8m.pt

# Training runs output (large images/charts - regenerated by training)
runs/
animal_detection/runs/
waste_classification/runs/

# Dataset images & splits (large — use Roboflow / local scripts to restore)
# NOTE: Previously only `dataset/test/` at repo root was ignored; YOLO data lives
# under `animal_detection/dataset/...` and similar, so those paths must be listed.
**/dataset/train/
**/dataset/valid/
**/dataset/test/

# Explicit module paths (same intent as globs above; helps tooling / older Git)
dataset/train/
dataset/valid/
dataset/test/
animal_detection/dataset/train/
animal_detection/dataset/valid/
animal_detection/dataset/test/
waste_classification/dataset/train/
waste_classification/dataset/valid/
waste_classification/dataset/test/

# Waste classification layout uses `data_set/` (underscore) in this repo
**/data_set/train/
**/data_set/test/
**/data_set/valid/
waste_classification/data_set/

# Trained checkpoints (large — regenerate with train.py / pull from artifact storage)
animal_detection/models/*.pt
waste_classification/*.h5

# Local ML housekeeping (optional export from training scripts)
skipped_samples.tsv

# React / Node
node_modules/
frontend/build/

# OS
.DS_Store
Thumbs.db

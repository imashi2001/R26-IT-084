# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.env
*.egg-info/
dist/
build/
.venv/
venv/

# YOLO base model (downloaded automatically, not needed in repo)
yolov8n.pt
yolov8s.pt
yolov8m.pt

# Offline evaluation (regenerated by evaluate_all.py)
evaluation_results/yolo_runs/

animal_detection/runs/
waste_classification/runs/

# Dataset images & splits (large — use Roboflow / local scripts to restore)
# Nested under animal_detection/, waste_classification/, etc.; globs cover future layouts.
**/dataset/train/
**/dataset/valid/
**/dataset/test/

dataset/train/
dataset/valid/
dataset/test/
animal_detection/dataset/train/
animal_detection/dataset/valid/
animal_detection/dataset/test/
waste_classification/dataset/train/
waste_classification/dataset/valid/
waste_classification/dataset/test/

# Waste classification layout uses `data_set/` (underscore) in this repo
**/data_set/train/
**/data_set/test/
**/data_set/valid/
waste_classification/data_set/

# Copy of base weights sometimes dropped next to training scripts
animal_detection/yolov8n.pt

# Local checkpoints — broad ignore; deployable copies under services/ stay tracked (see below)
animal_detection/models/
*.h5
*.pt
!services/waste-api/model/waste_classification_model.h5
!services/animal-api/model/best.pt

# Local ML housekeeping (optional export from training scripts)
skipped_samples.tsv

# React / Node
node_modules/
frontend/dist/

# Flutter / Android (local build cache — never commit)
mobile_app/android/.gradle/
mobile_app/android/.idea/
mobile_app/android/local.properties
mobile_app/android/**/build/
mobile_app/.dart_tool/
mobile_app/build/

# MapTiler / local Flutter secrets (never commit real keys)
mobile_app/dart_defines.json

# Backend local
backend/.env
backend/.device_id
.bridge_id
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

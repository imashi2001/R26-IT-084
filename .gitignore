venv/
# `python -m venv .venv` — must be ignored; `venv/` alone does not match `.venv/`
.venv/
**/.venv/
data_set/
dataset/
*.h5
*.pt
__pycache__/
skipped_samples.tsv

# Training / inference outputs (regeneratable artifacts)
runs/
animal_detection/runs/
animal_detection/models/
animal_detection/yolov8n.pt

# Per-host stable device id (laptop bridge / dyno)
backend/.device_id
.bridge_id

# Node.js (Express backend)
node_modules/
backend/.env
*.log
npm-debug.log*

# Allow the two deployable copies under services/ even though *.h5 / *.pt
# are otherwise globally ignored. Keep a single weight per service folder.
!services/waste-api/model/waste_classification_model.h5
!services/animal-api/model/best.pt

# ============================================================
# Backend (Express) - environment variables
# Copy to .env locally; set the same vars on Railway in production.
# ============================================================

# ---- HTTP server ----
PORT=5000
CORS_ORIGIN=http://localhost:5173

# ---- Model microservices (Railway URLs after deploy) ----
# Both URLs can omit https:// — env.js will normalize them.
MODEL_WASTE_URL=http://localhost:8001
MODEL_ANIMAL_URL=http://localhost:8002

# Optional: FastAPI fill-api (bin fill levels — garbage_fill_level_detection_v1).
# POST /predict multipart field "file". Labels empty|half|overflow → Empty/Half/Overflow tier.
# Legacy alias: MODEL_YOLO_URL (old Flask model-yolo) still works if MODEL_FILL_URL is unset.
MODEL_FILL_URL=http://localhost:8005

# Optional: FastAPI litter-severity-api (YOLO + LSI). When unset, POST /litter-severity returns 503.
# POST /predict on litter service uses multipart field "file" (same as waste/animal).
MODEL_LITTER_URL=http://localhost:8003

# Optional: FastAPI littering-action-api (YOLO11 littering-event detector).
# When unset, POST /littering-action returns 503 and /predict omits littering_action.
MODEL_LITTERING_ACTION_URL=http://localhost:8004

# Optional: FastAPI forecast-api (XGBoost municipal waste forecasting).
# Powers GET /api/waste-data, /api/waste-trend, /api/waste-insights.
# When unset, backend falls back to local Python (dev only — not for Railway).
MODEL_FORECAST_URL=http://localhost:8006
FORECAST_TIMEOUT_MS=45000
FORECAST_RETRAIN_TIMEOUT_MS=120000
# Optional: explicit Python for local forecast fallback (dev). Use .venv path if system python lacks xgboost.
# FORECAST_PYTHON=C:\path\to\repo\.venv\Scripts\python.exe
MODEL_LITTERING_ACTION_TIMEOUT_MS=15000
LITTERING_ALERT_CONFIDENCE=0.50
LITTERING_ALERT_COOLDOWN_SECONDS=300

# Default model when client doesn't specify one (used only with
# /predict?model=waste or =animal; both run by default).
DEFAULT_MODEL=waste

INFER_TIMEOUT_SECONDS=60
MAX_UPLOAD_MB=25

# ---- Postgres (optional) ----
# Leave empty to run without persistence; /predict still works.
# MySQL URL example: mysql://user:pass@host:3306/visionwaste
# Creates users, devices, captures, alerts, device_commands, waste_entries when DB_SYNC=true.
# For the admin auth flow you must set DATABASE_URL (Postgres) and run
# the backend once with DB_SYNC=true so the users table gets created
# (or with DB_SYNC_ALTER=true to add the new admin_name / municipal_council
# / covered_area columns to an existing users table).
# When DB_SYNC runs, Sequelize also creates the alerts table (operational
# notifications derived from captures; see GET /alerts and PATCH /alerts/:id)
# and device_commands (ESP32 remote audio queue; see POST /devices/:id/audio-test).
DATABASE_URL=
DB_SYNC=false
DB_SYNC_ALTER=false
DB_LOGGING=false

# ---- Auth (required for /auth/* and admin device CRUD) ----
# Set JWT_SECRET to any random string (>= 32 chars recommended) before
# enabling login. In production (NODE_ENV=production) the server refuses to
# start without JWT_SECRET and DATABASE_URL.
# POST /auth/register expects
#   { adminName, email, municipalCouncil, coveredArea, password, adminInvite }
# and creates every account with role="admin". Passwords need >= 8 characters.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# The first account can register without a code. Every later registration
# must send adminInvite equal to this value; leave empty to close sign-up.
ADMIN_INVITE_SECRET=

# Login/register attempts allowed per IP per window.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# ---- Device auth (ESP32 boards + laptop bridge) ----
# When set, POST /predict, GET /devices/commands, POST /devices/commands/:id/ack
# and /bridge/* require header X-Device-Key with this value (or a logged-in
# user's JWT). Put the same value in VisionWaste/*/secrets.h and the bridge's
# DEVICE_API_KEY env var. Empty = open (legacy, warned at startup).
DEVICE_API_KEY=

# ---- Weather + risk engine ----
# Empty key => weatherService falls back to a deterministic stub.
OPENWEATHER_API_KEY=

# Public MapTiler key served to the mobile app via GET /map/config.
# Same key you use for the website (VITE_MAPTILER_KEY). Leave empty for CARTO tiles.
MAPTILER_KEY=
DEFAULT_WEATHER_LAT=6.9271
DEFAULT_WEATHER_LON=79.8612
HIGH_TEMP_C=30
HIGH_HUMIDITY_PCT=70

# ---- ESP32 auto audio after /predict (scenario-based tracks) ----
# When true, ESP32 uploads (source_type=esp32) queue one PLAY_AUDIO track after /predict.
# Track numbers are configured in the dashboard: Speaker Check → Audio track assignment
# (GET/PUT /dashboard/settings/audio). Priority: highest model confidence % among littering, fill, animal, custom rules, correct dumping.
AUTO_AUDIO_ON_PREDICT=true
# Same track auto-plays at most twice inside this window; extra requests are cancelled.
AUDIO_TRIGGER_COOLDOWN_SECONDS=60

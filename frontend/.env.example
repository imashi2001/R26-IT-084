# Copy to .env.local (do not commit secrets)

# Backend API origin — production Railway build MUST include https://
# REACT_APP_API_URL=https://your-backend.up.railway.app

# Default ESP32 snapshot URL (LAN). Browser fetch only works from http://localhost dev;
# HTTPS-deployed sites cannot load http:// ESP32 — use VisionWaste/bridge instead.
# REACT_APP_ESP32_CAPTURE_URL=http://10.134.126.191/capture

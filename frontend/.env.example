# Local dev: leave empty to use Vite proxy → http://localhost:5000
# VITE_API_URL=http://localhost:5000

# Production / Railway frontend service:
# VITE_API_URL=https://your-backend.up.railway.app

# Optional ESP32 live capture (HomePage default fallback)
# VITE_ESP32_CAPTURE_URL=http://192.168.x.x/capture

# Optional device id for live monitoring card
# VITE_LIVE_DEVICE_ID=esp32-001
